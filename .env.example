AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_PLANNER_MODEL=gpt-5
OPENAI_CODE_IMAGE_MODEL=gpt-5
OPENAI_VISION_MODEL=gpt-5
OPENAI_BACKGROUND_IMAGE_MODEL=gpt-image-1
OPENAI_BACKGROUND_IMAGE_SIZE=1024x1024

# Optional migration fallback. Leave blank when OpenAI is the only provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
PLANNER_GEMINI_API_KEY=
PLANNER_MODEL=gemini-flash-latest
GRAPHIC_GEMINI_API_KEYS=
GRAPHIC_GEMINI_IMAGE_MODEL=gemini-flash-latest

APP_API_KEY=your_app_api_key_here

# Public URL used in generated preview/download links.
# Local central server default: http://127.0.0.1:8000
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated frontend origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://tauri.localhost,tauri://localhost

LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=graphic-agent-testing

# ============================================================
# DESKTOP LOCAL STORAGE
# ============================================================

# Desktop uses SQLCipher + Windows Credential Manager. PostgreSQL is optional
# and must be selected explicitly with STORAGE_BACKEND=postgres for a server.
STORAGE_BACKEND=sqlite
# Optional desktop override; normally Tauri supplies AGENTIC_CONFIG_DIR.
AGENTIC_SQLITE_PATH=

# Optional shared SVG icon mirror. The folder must be shared with the Drive
# account used by the application. Keep access tokens outside the installer;
# use Credential Manager/OAuth setup before enabling this feature.
GOOGLE_DRIVE_ICON_SYNC_ENABLED=false
GOOGLE_DRIVE_ICON_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=
GOOGLE_DRIVE_ICON_PULL_INTERVAL_SECONDS=30

# Optional PostgreSQL deployment settings. Leave blank for desktop SQLite mode.
# A single DATABASE_URL may be used as a shared fallback for auth, icon library,
# and provider-secret storage. Explicit *_DATABASE_URL values take precedence.
DATABASE_URL=
ICON_LIBRARY_DATABASE_URL=
ICON_LIBRARY_DB_CONNECT_TIMEOUT=10
# Apply auth, provider-secret, and icon-library migrations during server startup.
# Set false only when a separate deployment step owns migrations.
POSTGRES_AUTO_MIGRATE=true
ICON_LIBRARY_AUTO_MIGRATE=false

# Authentication database URL is only used when STORAGE_BACKEND=postgres.
AUTH_DATABASE_URL=
AUTH_DB_CONNECT_TIMEOUT=10
# Desktop mode creates this in Windows Credential Manager automatically.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_ALLOWED_EMAIL_DOMAINS=

# Desktop mode stores this key in Windows Credential Manager automatically.
PROVIDER_SECRETS_ENCRYPTION_KEY=
PROVIDER_SECRET_ALLOWED_PROVIDERS=openai,gemini,higgsfield

MOTION_VIDEO_GATEWAY=higgsfield
HF_VIDEO_PROVIDER=fal-ai
HF_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B
HF_TOKEN=your_huggingface_token_here

